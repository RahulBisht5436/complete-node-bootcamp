extends base

//- all the mixin for the tour are inside this mixin
include ./mixin/tourMixin.pug
include ./mixin/utilityMixin.pug

block prepend head
  script(src="/js/mapbox.js")

block content
  section.section-header
    .header__hero
      .header__hero-overlay &nbsp;
      img.header__hero-img(src=`/img/tours/${data.imageCover}`, alt=`${data.name}`)

    .heading-box
      h1.heading-primary
        span= data.name
      .heading-box__group
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-clock')
          span.heading-box__text= `${data.duration}  days`
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-map-pin')
          span.heading-box__text= data.startLocation.description

  section.section-description
    .overview-box
      div
        .overview-box__group
          h2.heading-secondary.ma-bt-lg Quick facts
          
          +overviewDiv("calendar","Next date",`${new Date(data.startDates[0]).toLocaleString('en-US', {month: 'long',year: 'numeric'})}`)
          +overviewDiv("trending-up","Difficulty",`${data.difficulty}`)
          +overviewDiv("user","Participants", `${data.maxGroupSize}`)
          if data.ratingAverage >0
            +overviewDiv("star","Rating",`${data.ratingAverage} / 5`)

        .overview-box__group
          h2.heading-secondary.ma-bt-lg Your tour guides
          each guide, i in data.guides
            - let role = ""
            if i === 0
              - role = "LEAD GUIDE"
            else if i === 1
              - role = "GUIDE"
            else
              - role = "INTERN"
            
            if i <= 2
              +guideCode(guide.name, role, guide.photo)

    .description-box
      h2.heading-secondary.ma-bt-lg= `About ${data.name} tour`
      - const description = data.description.split('\n')
      each para in description 
        p.description__text= para  
      

  section.section-pictures
    each image in data.images
      +showImages(image)

  section.section-map
    #map

  
  
  section.section-reviews
    .reviews
      each review in data.reviews
        //- +utilityPrint(review)
        +renderReviews(review.user.name,review.review,review.rating,review.user.photo)
      
  p.classtest= data.images[0]
  
  section.section-cta
    .cta
      .cta__img.cta__img--logo
        img(src='/img/logo-white.png', alt='Natours logo')
      img.cta__img.cta__img--1(src=`/img/tours/${data.images[1]}`, alt='')
      img.cta__img.cta__img--2(src=`/img/tours/${data.images[2]}`, alt='')
      .cta__content
        h2.heading-secondary What are you waiting for?
        p.cta__text #{data.duration} days. 1 adventure. Infinite memories. Make it yours today!
        button.btn.btn--green.span-all-rows Book tour now!
