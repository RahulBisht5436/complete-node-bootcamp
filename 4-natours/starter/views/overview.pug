extends base

block content
  main.main
    .card-container
      each cardData in data
        .card
          .card__header
            .card__picture
              .card__picture-overlay &nbsp;
              img.card__picture-img(src=`img/tours/${cardData.imageCover}`, alt=cardData.name)

            h3.heading-tertirary
              span #{cardData.name} 

          .card__details
            h4.card__sub-heading= `${cardData.difficulty} ${cardData.duration}-day tour`
            p.card__text= cardData.summary

            .card__data
              svg.card__icon
                use(xlink:href="img/icons.svg#icon-map-pin")
              span #{cardData.startLocation.description}

            .card__data
              svg.card__icon
                use(xlink:href="img/icons.svg#icon-calendar")
              span= new Date(cardData.startDates[0]).toLocaleString('en-US', {month: 'long',year: 'numeric'})


            .card__data
              svg.card__icon
                use(xlink:href="img/icons.svg#icon-flag")
              span= `${cardData.locations.length} stops`

            .card__data
              svg.card__icon
                use(xlink:href="img/icons.svg#icon-user")
              span= `${cardData.maxGroupSize} People`

          .card__footer
            p
              span.card__footer-value $297
              span.card__footer-text per person

            p.card__ratings
              span.card__footer-value 4.9
              span.card__footer-text rating (21)

            a.btn.btn--green.btn--small(href="#") Details

